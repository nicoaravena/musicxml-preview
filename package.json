{
  "name": "musicxml-preview",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:xml"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicoaravena/musicxml-preview"
  },
  "publisher": "nicoaravena",
  "license": "MIT",
  "contributes": {
    "languages": [
      {
        "id": "xml",
        "extensions": [
          ".musicxml"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "musicxmlPreview.scoreViewer",
        "displayName": "%customEditor.scoreViewer.displayName%",
        "selector": [
          {
            "filenamePattern": "*.mxl"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "musicxmlPreview.showPreviewToSide",
        "title": "%command.showPreviewToSide.title%",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "musicxmlPreview.showPreviewToSide",
          "when": "musicxmlPreview.isScore || resourceExtname == .musicxml",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "musicxmlPreview.showPreviewToSide",
          "when": "musicxmlPreview.isScore || resourceExtname == .musicxml"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "pnpm run check-types && pnpm run lint && tsc -p ./ && node esbuild.js",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "check-types": "tsc --noEmit && tsc --noEmit -p src/webview",
    "test": "pnpm run compile && vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "~1.140.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "opensheetmusicdisplay": "3.0.0"
  }
}
